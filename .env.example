# Copy to .env for docker compose overrides. Everything has sane defaults.

# Profile: local (Ollama, keyless) | cloud (Anthropic/OpenAI) | keyless (no chat)
SPRING_PROFILES_ACTIVE=local

# Local-profile models (pulled by the ollama-init service on first run)
CORPUS_CHAT_MODEL=qwen3:4b
CORPUS_EMBEDDING_MODEL=nomic-embed-text

# Cloud profile
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# CORPUS_CHAT_PROVIDER=anthropic        # or openai
# CORPUS_CHAT_MODEL=claude-sonnet-4-5
# CORPUS_EMBEDDING_PROVIDER=transformers # or openai (then set dimension 1536 + wipe)
# CORPUS_EMBEDDING_DIMENSION=384

# Security — override outside local development
# CORPUS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Tuning
# CORPUS_CHUNK_SIZE=512
# CORPUS_CHUNK_OVERLAP=64
# CORPUS_RETRIEVAL_TOP_K=6
# CORPUS_RRF_K=60
# CORPUS_RATE_LIMIT_RPM=30
