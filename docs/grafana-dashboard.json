{
  "uid": "corpus-rag",
  "title": "Corpus \u2014 RAG Observability",
  "tags": [
    "corpus",
    "llm",
    "rag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estimated LLM spend (session)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(corpus_llm_cost_estimate_usd_total)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Retrieval top score (fleet mean, 15m)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(corpus_retrieval_top_score_observed_sum[15m])) / sum(rate(corpus_retrieval_top_score_observed_count[15m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retrieval score spread (fleet mean, 15m)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(corpus_retrieval_score_spread_observed_sum[15m])) / sum(rate(corpus_retrieval_score_spread_observed_count[15m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate-limited requests (429/min)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[5m])) * 60 or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token throughput (tokens/min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, model) (rate(corpus_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{direction}} \u00b7 {{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Estimated cost rate (USD/hour)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(corpus_llm_cost_estimate_usd_total[15m])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAG phase latency p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(corpus_rag_phase_seconds_bucket[5m])))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP request rate by endpoint",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*|/mcp\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rerank latency p95 (by head)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, reranker) (rate(corpus_retrieval_rerank_seconds_bucket[5m])))",
          "legendFormat": "{{reranker}}"
        }
      ],
      "description": "Cross-encoder inference sits on the request path. If this climbs while corpus_rerank_failures_total{reason=\"shed\"} also climbs, the bulkhead is saturated."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rerank fallbacks to fusion order (per min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(corpus_rerank_failures_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Reranking fails open, so this is the only signal that ranking quality has silently degraded. Any sustained non-zero rate means the eval numbers no longer describe production."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Embedding cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(corpus_embedding_cache_total{result=\"hit\"}[10m])) / clamp_min(sum(rate(corpus_embedding_cache_total[10m])), 0.001)",
          "legendFormat": "hit ratio"
        },
        {
          "refId": "B",
          "expr": "sum by (tier) (rate(corpus_embedding_cache_total{result=\"hit\"}[10m])) / clamp_min(sum(rate(corpus_embedding_cache_total[10m])), 0.001)",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Response cache outcomes (per min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(corpus_response_cache_total[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "description": "hit-exact costs no embedding at all; hit-semantic pays one. If hit-semantic stays at zero the similarity threshold is too high to earn its keep."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cost avoided by caching (USD/hour, est.)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(corpus_response_cache_total{result=~\"hit.*\"}[1h])) * 3600 * (sum(increase(corpus_llm_cost_estimate_usd_total[1h])) / clamp_min(sum(increase(corpus_llm_tokens_total[1h])) / 1000, 0.001)) / 1000",
          "legendFormat": "avoided"
        }
      ],
      "description": "Cache hits x the observed cost per answer. An estimate by construction - the counter it leans on is itself an estimate from a price table."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Quota refusals (per min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "corpus-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(corpus_quota_blocked_total[5m])) * 60",
          "legendFormat": "blocked"
        }
      ],
      "description": "A sustained non-zero rate usually means the ceiling is set too low for normal use, not that abuse is being stopped. Check /api/usage for the affected user."
    }
  ]
}
